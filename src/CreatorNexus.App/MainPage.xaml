<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:CreatorNexus.Core;assembly=CreatorNexus.Core"
             x:Class="CreatorNexus.App.MainPage"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3">
                <Label Text="CreatorNexus" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label x:Name="SubtitleLabel" Text="Jouw creatieve commandocentrum" FontSize="13" TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
            <Button x:Name="LanguageButton" Grid.Column="1" Text="EN" Clicked="OnLanguageClicked" BackgroundColor="{StaticResource PanelBackground}" TextColor="White" CornerRadius="12" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18">
                <Border BackgroundColor="{StaticResource PanelBackground}" Stroke="#303044" Padding="18" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="WelcomeLabel" Text="Maak van ideeën echte projecten." FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="IntroLabel" Text="Bewaar ideeën, organiseer content en houd je volgende stap in zicht." FontSize="14" TextColor="{StaticResource TextMuted}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Entry x:Name="NewProjectEntry" Placeholder="Naam van je nieuwe project…" ReturnType="Done" BackgroundColor="#262638" TextColor="White" PlaceholderColor="#9CA3AF" />
                            <Button x:Name="TemplateButton" Grid.Column="1" Text="Sjabloon" Clicked="OnCreateFromTemplateClicked" BackgroundColor="#30264A" TextColor="White" CornerRadius="12" />
                            <Button x:Name="AddButton" Grid.Column="2" Text="+ Nieuw" Clicked="OnAddProjectClicked" BackgroundColor="{StaticResource AccentPurple}" TextColor="White" CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="ExportBackupButton" Text="Back-up maken" Clicked="OnExportBackupClicked" BackgroundColor="#30264A" TextColor="White" CornerRadius="12" />
                    <Button x:Name="RestoreBackupButton" Grid.Column="1" Text="Back-up terugzetten" Clicked="OnRestoreBackupClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="12" />
                </Grid>

                <Button x:Name="RecoverLocalBackupButton" Text="Herstel lokale back-up" Clicked="OnRecoverLocalBackupClicked" BackgroundColor="#422F52" TextColor="White" CornerRadius="12" />

                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <Label x:Name="ProjectsHeading" Text="Jouw projecten" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                    <Label x:Name="ProjectCountLabel" Grid.Column="1" Text="0 projecten" FontSize="13" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                    <Button x:Name="FavoriteFilterButton" Grid.Column="2" Text="★" Clicked="OnToggleFavoritesFilterClicked" BackgroundColor="{StaticResource PanelBackground}" TextColor="#FDE68A" CornerRadius="10" Padding="10,6" />
                    <Button x:Name="ScheduleViewButton" Grid.Column="3" Text="📅" Clicked="OnToggleScheduleViewClicked" BackgroundColor="{StaticResource PanelBackground}" TextColor="White" CornerRadius="10" Padding="10,6" />
                    <Button x:Name="ArchiveViewButton" Grid.Column="4" Text="Archief" Clicked="OnToggleArchivedViewClicked" BackgroundColor="{StaticResource PanelBackground}" TextColor="White" CornerRadius="10" Padding="10,6" />
                </Grid>

                <SearchBar x:Name="ProjectSearchBar" Placeholder="Zoek projecten…" TextChanged="OnSearchTextChanged" BackgroundColor="{StaticResource PanelBackground}" TextColor="White" PlaceholderColor="#9CA3AF" />

                <CollectionView x:Name="ProjectsCollection" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource PanelBackground}" Stroke="#303044" Padding="20" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="EmptyTitleLabel" Text="Nog geen projecten" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label x:Name="EmptySubtitleLabel" Text="Maak hierboven je eerste creatorproject." FontSize="13" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="core:CreatorProject">
                            <Border BackgroundColor="{StaticResource PanelBackground}" Stroke="#303044" Padding="16" Margin="0,0,0,10" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Channel}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="{Binding Status}" FontSize="12" TextColor="#C4B5FD" />
                                    <Label Grid.Row="3" Grid.Column="0" Text="{Binding Notes}" FontSize="13" TextColor="{StaticResource TextMuted}" LineBreakMode="WordWrap" />
                                    <Label Grid.Row="4" Grid.Column="0" Text="{Binding ScheduledFor, StringFormat='Gepland: {0:dd-MM-yyyy}'}" FontSize="12" TextColor="#A5B4FC" />
                                    <Label Grid.Row="5" Grid.Column="0" Text="{Binding Tags, StringFormat='Tags: {0}'}" FontSize="12" TextColor="{StaticResource TextMuted}" LineBreakMode="WordWrap" />
                                    <Label Grid.Row="6" Grid.Column="0" Text="{Binding ChecklistProgress, StringFormat='Checklist: {0}'}" FontSize="12" TextColor="#A5B4FC" SemanticProperties.Description="Checklist progress / Voortgang checklist" />
                                    <Button Grid.Column="1" Grid.Row="5" Text="# Tags" CommandParameter="{Binding Id}" Clicked="OnEditTagsClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="10" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Grid.Row="5" Text="☑" CommandParameter="{Binding Id}" Clicked="OnEditChecklistClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="10" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Grid.Row="0" Text="✓" SemanticProperties.Description="Projectstatus verderzetten / Advance project status" CommandParameter="{Binding Id}" Clicked="OnAdvanceStatusClicked" BackgroundColor="#30264A" TextColor="#DDD6FE" CornerRadius="12" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Grid.Row="0" Text="✎" SemanticProperties.Description="Projecttitel en kanaal wijzigen / Edit project title and channel" CommandParameter="{Binding Id}" Clicked="OnEditProjectClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="12" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Grid.Row="3" Text="✎" SemanticProperties.Description="Projectnotities bewerken / Edit project notes" CommandParameter="{Binding Id}" Clicked="OnEditNotesClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="12" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Grid.Row="1" Text="★" SemanticProperties.Description="Favoriet aan- of uitzetten / Toggle favorite" CommandParameter="{Binding Id}" Clicked="OnToggleFavoriteClicked" BackgroundColor="#3B3154" TextColor="#FDE68A" CornerRadius="12" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Grid.Row="4" Text="📅" SemanticProperties.Description="Publicatiedatum instellen / Set scheduled date" CommandParameter="{Binding Id}" Clicked="OnScheduleProjectClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="10" VerticalOptions="Center" />
                                    <Button Grid.Column="0" Grid.Row="7" Text="Archiveren / herstellen" CommandParameter="{Binding Id}" Clicked="OnToggleArchiveClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="10" HorizontalOptions="Start" />
                                    <Button Grid.Column="0" Grid.Row="8" Text="✍ Script" CommandParameter="{Binding Id}" Clicked="OnEditScriptClicked" BackgroundColor="#30264A" TextColor="White" CornerRadius="10" HorizontalOptions="Start" />
                                    <Button Grid.Column="1" Grid.Row="8" Text="▤ Media" CommandParameter="{Binding Id}" Clicked="OnEditMediaLibraryClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="10" />
                                    <Button Grid.Column="2" Grid.Row="8" Text="▣ Thumbnail" CommandParameter="{Binding Id}" Clicked="OnEditThumbnailClicked" BackgroundColor="#30264A" TextColor="White" CornerRadius="10" />
                                    <Button Grid.Column="0" Grid.Row="9" Text="＋ Bestand toevoegen" CommandParameter="{Binding Id}" Clicked="OnAddMediaFileClicked" BackgroundColor="#262638" TextColor="White" CornerRadius="10" HorizontalOptions="Start" />
                                    <Button Grid.Column="1" Grid.Row="9" Text="⧉ Kopiëren" CommandParameter="{Binding Id}" Clicked="OnDuplicateProjectClicked" BackgroundColor="#30264A" TextColor="White" CornerRadius="10" />
                                    <Button Grid.Column="2" Grid.Row="7" Text="🗑" SemanticProperties.Description="Project verwijderen / Delete project" CommandParameter="{Binding Id}" Clicked="OnDeleteProjectClicked" BackgroundColor="#42252D" TextColor="White" CornerRadius="10" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="FooterLabel" Text="Lokale opslag • Offline beschikbaar • Gratis" FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" Margin="0,8,0,12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>