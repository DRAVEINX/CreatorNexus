<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType><RootNamespace>CreatorNexus.App</RootNamespace><UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationTitle>CreatorNexus</ApplicationTitle>
    <ApplicationId>com.draveinx.creatornexus</ApplicationId><ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\CreatorNexus.Core\CreatorNexus.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#7C3AED" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#11111B" BaseSize="128,128" />
  </ItemGroup>
</Project>
